generator client {
  provider        = "prisma-client"
  // For pg_trgm, which indexes User.name for the mention search
  previewFeatures = ["postgresqlExtensions"]
  output          = "./generated"
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// User, Session, Account and Verification are used by Better Auth
// (src/lib/auth.ts), which leaves id generation to Prisma.

model User {
  id                  String           @id @default(uuid(7)) @db.Uuid
  email               String           @unique
  // Used for sign-in and in profile URLs: only a-z, 0-9 and _ (validated in src/lib/auth.ts)
  username            String           @unique @db.VarChar(30)
  // Display name
  name                String           @db.VarChar(50)
  // Shown on the profile; null when the user hasn't written one
  bio                 String?          @db.VarChar(160)
  emailVerified       Boolean          @default(false)
  image               String?
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)
  sessions            Session[]
  accounts            Account[]
  posts               Post[]
  // Follows where this user is the follower, i.e. whom they follow
  following           Follow[]         @relation("FollowFollower")
  // Follows where this user is followed, i.e. their followers
  followers           Follow[]         @relation("FollowFollowing")
  likes               Like[]
  comments            Comment[]
  // Where this user is @mentioned
  postMentions        PostMention[]
  commentMentions     CommentMention[]
  commentLikes        CommentLike[]
  // What happened to this user's posts and replies, for /notifications
  notifications       Notification[]   @relation("NotificationRecipient")
  // Notifications this user caused by replying, liking, mentioning or
  // following
  causedNotifications Notification[]   @relation("NotificationActor")

  // The mention search: case-insensitive matches anywhere in the name
  // (ILIKE). Usernames are searched by prefix through their unique index,
  // which works for LIKE 'abc%' because the database collation is C.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  // "credential" for email/password, or an OAuth provider like "google"
  providerId            String
  accountId             String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Password hash, only set on "credential" accounts
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
}

model Post {
  id            String         @id @default(uuid(7)) @db.Uuid
  // Plain text only; the limit is POST_MAX_LENGTH in src/features/posts/utils/post-rules.ts
  content       String         @db.VarChar(160)
  authorId      String         @db.Uuid
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // The number of Like rows for this post, kept in step with them by
  // src/features/likes/actions/set-liked.ts, so feeds don't count likes
  likeCount     Int            @default(0)
  likes         Like[]
  // The number of comments, kept in step by
  // src/features/comments/actions/create-comment.ts
  commentCount  Int            @default(0)
  comments      Comment[]
  mentions      PostMention[]
  notifications Notification[]
  // Milliseconds, like JavaScript dates, so a (createdAt, id) feed cursor
  // that went through the browser still matches the stored value exactly
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  // Feeds are sorted newest first, with id as a tiebreaker so a
  // (createdAt, id) cursor can page through them later
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  // Profile feeds, and later the home feed of followed authors
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
}

// followerId follows followingId. A user can't follow themselves (checked in
// src/features/follows/actions/set-following.ts).
model Follow {
  followerId  String   @db.Uuid
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @db.Uuid
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  // Milliseconds, like Post.createdAt, for (createdAt, user id) cursors
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  // One follow per pair. Also the index for "whom does X follow", which
  // the home feed needs, and for "does X follow Y".
  @@id([followerId, followingId])
  // X's followers, newest first, for the followers list and count
  @@index([followingId, createdAt(sort: Desc), followerId])
  // Whom X follows, newest first, for the following list
  @@index([followerId, createdAt(sort: Desc), followingId])
}

// userId likes postId
model Like {
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // One like per user and post. Also the index for "does the viewer like
  // these posts", which every feed page asks.
  @@id([postId, userId])
  // A user's likes, e.g. for a list of liked posts, and for deleting them
  // with the user
  @@index([userId, createdAt(sort: Desc)])
}

// A reply to a post. Users see "reply"; the code calls it a comment.
model Comment {
  id            String           @id @default(uuid(7)) @db.Uuid
  // Plain text only; the limit is COMMENT_MAX_LENGTH in
  // src/features/comments/utils/comment-rules.ts
  content       String           @db.VarChar(160)
  postId        String           @db.Uuid
  post          Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String           @db.Uuid
  author        User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions      CommentMention[]
  // The number of CommentLike rows, kept in step with them by
  // src/features/likes/actions/set-comment-liked.ts, so lists don't count
  likeCount     Int              @default(0)
  likes         CommentLike[]
  // Set on replies: the comment they answer, the top-level comment or a
  // level 1 reply (see src/features/comments/actions/create-comment.ts)
  parentId      String?          @db.Uuid
  parent        Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]        @relation("CommentReplies")
  // Set on replies: the top-level comment of their thread, so a whole
  // thread loads in one query
  rootId        String?          @db.Uuid
  root          Comment?         @relation("CommentThread", fields: [rootId], references: [id], onDelete: Cascade)
  threadReplies Comment[]        @relation("CommentThread")
  notifications Notification[]
  // The number of replies below it, on top-level comments and level 1
  // replies (deeper ones can't be answered, so they keep 0), kept in step
  // by
  // src/features/comments/actions/create-comment.ts
  replyCount    Int              @default(0)
  // Milliseconds, like Post.createdAt, for (createdAt, id) cursors
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  // A post's top-level comments (parentId null) in order, for listing and
  // paging them
  @@index([postId, parentId, createdAt, id])
  // A comment's direct replies, e.g. for counting them and deleting them
  // with it
  @@index([parentId, createdAt, id])
  // A whole thread's replies in order, loaded at once when it opens
  @@index([rootId, createdAt, id])
  // A user's comments, and deleting them with the user
  @@index([authorId])
}

// A user @mentioned in a post, saved with the post. Only real users are
// saved, so only their @usernames become links.
model PostMention {
  postId String @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One per user and post. Also the index for "who is mentioned in these
  // posts", which every page of posts asks.
  @@id([postId, userId])
  // "Where is this user mentioned", e.g. for notifications
  @@index([userId])
}

// A user @mentioned in a comment, like PostMention
model CommentMention {
  commentId String  @db.Uuid
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
}

// userId likes commentId, like Like for posts
model CommentLike {
  commentId String   @db.Uuid
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  // One like per user and comment. Also the index for "does the viewer like
  // these comments", which every page of comments asks.
  @@id([commentId, userId])
  // A user's comment likes, e.g. for deleting them with the user
  @@index([userId, createdAt(sort: Desc)])
}

enum NotificationType {
  // Someone replied to the user's post or reply
  REPLY
  // Someone liked the user's post or reply
  LIKE
  // Someone @mentioned the user in a post or reply
  MENTION
  // Someone started following the user
  FOLLOW
}

// Something that happened to a user's posts or replies, shown on
// /notifications. Written together with what caused it (a reply, like or
// mention), in the same transaction, so the list is a single indexed read
// instead of collecting replies, likes and mentions on every page view.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  // Who is notified
  userId    String           @db.Uuid
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // Who replied, liked, mentioned or followed
  actorId   String           @db.Uuid
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      NotificationType
  // The post it's about, which it links to. Set on all but FOLLOW, which
  // links to the follower's profile.
  postId    String?          @db.Uuid
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Set when it's about a reply: the new reply (REPLY), the liked reply
  // (LIKE) or the reply with the mention (MENTION). Null when it's about
  // the post itself.
  commentId String?          @db.Uuid
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  // Milliseconds, like Post.createdAt, for (createdAt, id) cursors
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  // A user's notifications, newest first, paged by (createdAt, id). Also
  // for deleting them with the user.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  // The same, filtered to one type, for the tabs on /notifications
  @@index([userId, type, createdAt(sort: Desc), id(sort: Desc)])
  // Removing a like's notification on unlike, by post or by reply and
  // actor. Also for deleting them with the post or reply.
  @@index([postId, actorId])
  @@index([commentId, actorId])
  // Removing a follow's notification on unfollow, by follower and
  // followed user. Also for deleting them with the actor.
  @@index([actorId, userId])
}
